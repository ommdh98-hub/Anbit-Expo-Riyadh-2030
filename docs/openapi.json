  "components": {
    "schemas": {
      "ActionInput": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "deferred"
            ],
            "title": "Status"
          },
          "operator": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Operator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "operator"
        ],
        "title": "ActionInput"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "enum": [
              "user",
              "survey"
            ],
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "EstimateInput": {
        "properties": {
          "irrigated_area_m2": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Irrigated Area M2"
          },
          "root_depth_m": {
            "type": "number",
            "maximum": 3.0,
            "exclusiveMinimum": 0.0,
            "title": "Root Depth M"
          },
          "efficiency": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Efficiency"
          },
          "root_representative": {
            "type": "boolean",
            "title": "Root Representative"
          },
          "homogeneous": {
            "type": "boolean",
            "title": "Homogeneous"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "irrigated_area_m2",
          "root_depth_m",
          "efficiency",
          "root_representative",
          "homogeneous"
        ],
        "title": "EstimateInput"
      },
      "EventInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Id"
          },
          "recommendation_id": {
            "type": "string",
            "title": "Recommendation Id"
          },
          "volume": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Volume"
          },
          "unit": {
            "type": "string",
            "enum": [
              "L",
              "m3"
            ],
            "title": "Unit"
          },
          "volume_kind": {
            "type": "string",
            "enum": [
              "measured",
              "estimated"
            ],
            "title": "Volume Kind"
          },
          "executed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Executed At"
          },
          "operator": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Operator"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "title": "Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "recommendation_id",
          "volume",
          "unit",
          "volume_kind",
          "executed_at",
          "operator"
        ],
        "title": "EventInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InspectionInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Id"
          },
