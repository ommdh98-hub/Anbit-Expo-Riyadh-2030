  "components": {
    "schemas": {
      "ActionInput": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "deferred"
            ],
            "title": "Status"
          },
          "operator": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Operator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "operator"
        ],
        "title": "ActionInput"
      },
      "EstimateInput": {
        "properties": {
          "irrigated_area_m2": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Irrigated Area M2"
          },
          "root_depth_m": {
            "type": "number",
            "maximum": 3.0,
            "exclusiveMinimum": 0.0,
            "title": "Root Depth M"
          },
          "efficiency": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Efficiency"
          },
          "root_representative": {
            "type": "boolean",
            "title": "Root Representative"
          },
          "homogeneous": {
            "type": "boolean",
            "title": "Homogeneous"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "irrigated_area_m2",
          "root_depth_m",
          "efficiency",
          "root_representative",
          "homogeneous"
        ],
        "title": "EstimateInput"
      },
      "EventInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Id"
          },
          "recommendation_id": {
            "type": "string",
            "title": "Recommendation Id"
          },
          "volume": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Volume"
          },
          "unit": {
            "type": "string",
            "enum": [
              "L",
              "m3"
            ],
            "title": "Unit"
          },
          "volume_kind": {
            "type": "string",
            "enum": [
              "measured",
              "estimated"
            ],
            "title": "Volume Kind"
          },
          "executed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Executed At"
          },
          "operator": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Operator"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "title": "Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "recommendation_id",
          "volume",
          "unit",
          "volume_kind",
          "executed_at",
          "operator"
        ],
        "title": "EventInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InspectionInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Id"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Notes"
          },
          "operator": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Operator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "notes",
          "operator"
        ],
        "title": "InspectionInput"
      },
      "ReadingInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Id"
          },
          "point_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Point Id"
          },
          "x": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "X"
          },
          "y": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Y"
          },
          "value": {
            "type": "number",
            "minimum": 0.0,
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "enum": [
              "vwc_percent",
              "vwc_fraction",
              "raw"
            ],
            "title": "Unit"
          },
          "measured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Measured At"
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Source"
          },
          "operator": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Operator"
          },
          "quality": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "suspect"
            ],
            "title": "Quality"
          },
          "origin": {
            "type": "string",
            "enum": [
              "simulation",
              "manual",
              "field",
              "estimated"
            ],
            "title": "Origin"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "value",
          "unit",
          "measured_at",
          "source",
          "operator",
          "quality",
          "origin"
        ],
        "title": "ReadingInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}